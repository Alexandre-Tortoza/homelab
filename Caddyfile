{
    order sablier before reverse_proxy
}

# ── Homepage ─────────────────────────────────────────────────────────────────
home.{$HOMELAB_DOMAIN} {
    tls internal

    reverse_proxy homepage:3000 {
        header_up X-Forwarded-Proto https
        header_up X-Real-IP {remote_host}
    }

    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
    }
}

