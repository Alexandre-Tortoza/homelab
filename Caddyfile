{
    order sablier before reverse_proxy
}

# ── Gitea ─────────────────────────────────────────────────────────────────────
git.{$TAILSCALE_MACHINE}.ts.net {
    tls internal

    sablier http://sablier:10000 {
        group gitea
        session_duration {$GITEA_SESSION_DURATION}
        dynamic {
            display_name Gitea
            show_details true
            theme        hacker-terminal
            refresh_frequency 5s
            waiting_timeout   2m
        }
    }

    request_body {
        max_size 0
    }

    reverse_proxy gitea:3000 {
        flush_interval -1
        header_up X-Forwarded-Proto https
        header_up X-Real-IP {remote_host}
    }

    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
    }
}

# ── Vaultwarden ───────────────────────────────────────────────────────────────
vault.{$TAILSCALE_MACHINE}.ts.net {
    tls internal

    sablier http://sablier:10000 {
        group vaultwarden
        session_duration {$VAULTWARDEN_SESSION_DURATION}
        blocking {
            timeout 2m
        }
    }

    reverse_proxy vaultwarden:80 {
        header_up X-Forwarded-Proto https
        header_up X-Real-IP {remote_host}
    }

    header {
        -Server
        X-Content-Type-Options nosniff
    }
}

# ── Linkwarden ────────────────────────────────────────────────────────────────
