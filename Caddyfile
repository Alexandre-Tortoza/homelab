        }
    }

    request_body {
        max_size 0
    }

    reverse_proxy linkwarden:3000 {
        header_up X-Forwarded-Proto https
        header_up X-Real-IP {remote_host}
    }

    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
    }
}
