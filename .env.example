# ─────────────────────────────────────────────────────────────────────────────
# Homelab – variáveis de ambiente
# Copie para .env e preencha os valores marcados com CHANGE_ME
# Gere senhas e secrets com: openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────────────

# ── Geral ─────────────────────────────────────────────────────────────────────
TZ=America/Sao_Paulo
# UID e GID do usuário host (execute: id -u && id -g)
PUID=1000
PGID=1000

# ── Tailscale ─────────────────────────────────────────────────────────────────
# Nome da máquina no Tailscale – veja em: tailscale status (coluna "Name")
# ou em https://login.tailscale.com/admin/machines
# Todos os domínios derivam deste valor:
#   git.nisse.ts.net  |  vault.nisse.ts.net  |  links.nisse.ts.net
TAILSCALE_MACHINE=nisse

# IP Tailscale desta máquina – usado na configuração do AdGuard
# veja com: tailscale ip -4
TAILSCALE_IP=100.x.x.x

# ── Imagens (versões fixadas – altere conscientemente antes de atualizar) ─────
CADDY_IMAGE=homelab-caddy:local
GITEA_IMAGE=gitea/gitea:1.22.6
GITEA_DB_IMAGE=postgres:16.4-alpine
VAULTWARDEN_IMAGE=vaultwarden/server:1.32.7
LINKWARDEN_IMAGE=ghcr.io/linkwarden/linkwarden:v2.7.1
LINKWARDEN_DB_IMAGE=postgres:16.4-alpine
SABLIER_IMAGE=acouvreur/sablier:1.8.0
ADGUARD_IMAGE=adguard/adguardhome:v0.107.52

# ── Gitea ─────────────────────────────────────────────────────────────────────
GITEA_SSH_PORT=2222
GITEA_DB_NAME=gitea
GITEA_DB_USER=gitea
GITEA_DB_PASSWORD=CHANGE_ME

# Tempo de inatividade antes de escalar para zero (ex: 30m, 1h)
GITEA_SESSION_DURATION=30m

# ── Vaultwarden ───────────────────────────────────────────────────────────────
VAULTWARDEN_SIGNUPS_ALLOWED=false
# Gere um hash argon2: docker run --rm -it vaultwarden/server /vaultwarden hash --preset owasp
# Ou token simples para uso interno: openssl rand -base64 48
VAULTWARDEN_ADMIN_TOKEN=CHANGE_ME

# Tempo de inatividade antes de escalar para zero
# Mantenha baixo: apps Bitwarden sincronizam em background e acordam o container
VAULTWARDEN_SESSION_DURATION=10m

# SMTP opcional – deixe vazio para desabilitar email
VAULTWARDEN_SMTP_HOST=
VAULTWARDEN_SMTP_PORT=587
VAULTWARDEN_SMTP_SECURITY=starttls
VAULTWARDEN_SMTP_USERNAME=
VAULTWARDEN_SMTP_PASSWORD=
VAULTWARDEN_SMTP_FROM=

# ── Linkwarden ────────────────────────────────────────────────────────────────
LINKWARDEN_NEXTAUTH_SECRET=CHANGE_ME
LINKWARDEN_DISABLE_REGISTRATION=true
LINKWARDEN_DB_NAME=linkwarden
LINKWARDEN_DB_USER=linkwarden
LINKWARDEN_DB_PASSWORD=CHANGE_ME

# Tempo de inatividade antes de escalar para zero
LINKWARDEN_SESSION_DURATION=30m
