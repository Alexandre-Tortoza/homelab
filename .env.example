# ─────────────────────────────────────────────────────────────────────────────
# Homelab – variáveis de ambiente
# Copie para .env e preencha os valores marcados com CHANGE_ME
# Gere senhas e secrets com: openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────────────

# ── Geral ─────────────────────────────────────────────────────────────────────
TZ=America/Sao_Paulo
# UID e GID do usuário host (execute: id -u && id -g)
PUID=1000
PGID=1000

# ── Tailscale ─────────────────────────────────────────────────────────────────
# Domínio privado para os serviços (split-DNS Tailscale aponta para TAILSCALE_IP)
# Resulta em: git.homelab | vault.homelab | links.homelab
HOMELAB_DOMAIN=homelab

# Nome completo sem o sufixo .ts.net – veja: tailscale status --self --json
# Usado apenas para o domínio SSH do Gitea: ${TAILSCALE_MACHINE}.ts.net
TAILSCALE_MACHINE=machine.tailnet

# IP Tailscale desta máquina – veja com: tailscale ip -4
# Usado para expor o CoreDNS na porta 53 apenas via Tailscale
TAILSCALE_IP=100.x.x.x

# ── Imagens (versões fixadas – altere conscientemente antes de atualizar) ─────
CADDY_IMAGE=homelab-caddy:local
GITEA_IMAGE=gitea/gitea:1.27.1
GITEA_DB_IMAGE=postgres:18.4-alpine
VAULTWARDEN_IMAGE=vaultwarden/server:1.37.1
LINKWARDEN_IMAGE=ghcr.io/linkwarden/linkwarden:v2.8.4
LINKWARDEN_DB_IMAGE=postgres:18.4-alpine
ACTUAL_IMAGE=actualbudget/actual-server:25.7.1
MEALIE_IMAGE=ghcr.io/mealie-recipes/mealie:v2.5.0
MEALIE_DB_IMAGE=postgres:18.4-alpine
IMMICH_IMAGE=ghcr.io/immich-app/immich-server:release
IMMICH_ML_IMAGE=ghcr.io/immich-app/immich-machine-learning:release
IMMICH_DB_IMAGE=ghcr.io/immich-app/postgres:14-vectorchord0.3.0
IMMICH_REDIS_IMAGE=redis:7.2-alpine
PROMETHEUS_IMAGE=prom/prometheus:v3.4.1
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.9.1
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.52.1
GRAFANA_IMAGE=grafana/grafana:12.0.2
SABLIER_IMAGE=sablierapp/sablier:1.16.1
COREDNS_IMAGE=coredns/coredns:1.12.1
HOMEPAGE_IMAGE=ghcr.io/gethomepage/homepage:v1.7.0
KOPIA_IMAGE=kopia/kopia:0.22.3

# ── HD secundário ─────────────────────────────────────────────────────────────
# Todos os dados persistentes ficam no HD secundário para que o disco primário
# contenha apenas o OS e o repositório (a "receita"). Trocar de máquina =
# montar o HD e clonar o repo.
DATA_DIR=/mnt/hd2/homelab

# ── Kopia ─────────────────────────────────────────────────────────────────────
# Usuário e senha da interface web do Kopia. Gere com: openssl rand -base64 48
KOPIA_SERVER_USERNAME=admin
KOPIA_SERVER_PASSWORD=CHANGE_ME
# Senha de CRIPTOGRAFIA do repositório (diferente da senha da UI).
# Mantida apenas no .env — sem ela o repositório não pode ser aberto.
KOPIA_PASSWORD=CHANGE_ME
# Diretório onde o Kopia armazena os snapshots encriptados.
# Fica no mesmo HD que os dados para que tudo esteja no disco secundário.
KOPIA_REPOSITORY_PATH=/mnt/hd2/backups

# ── Gitea ─────────────────────────────────────────────────────────────────────
GITEA_SSH_PORT=2222
GITEA_DB_NAME=gitea
GITEA_DB_USER=gitea
GITEA_DB_PASSWORD=CHANGE_ME

# Tempo de inatividade antes de escalar para zero (ex: 30m, 1h)
GITEA_SESSION_DURATION=30m

# ── Vaultwarden ───────────────────────────────────────────────────────────────
VAULTWARDEN_SIGNUPS_ALLOWED=false
# Gere um hash argon2: docker run --rm -it vaultwarden/server /vaultwarden hash --preset owasp
# Ou token simples para uso interno: openssl rand -base64 48
VAULTWARDEN_ADMIN_TOKEN=CHANGE_ME

# Tempo de inatividade antes de escalar para zero
# Mantenha baixo: apps Bitwarden sincronizam em background e acordam o container
VAULTWARDEN_SESSION_DURATION=10m

# ── Linkwarden ────────────────────────────────────────────────────────────────
LINKWARDEN_NEXTAUTH_SECRET=CHANGE_ME
LINKWARDEN_DISABLE_REGISTRATION=true
LINKWARDEN_DB_NAME=linkwarden
LINKWARDEN_DB_USER=linkwarden
LINKWARDEN_DB_PASSWORD=CHANGE_ME

# Tempo de inatividade antes de escalar para zero
LINKWARDEN_SESSION_DURATION=30m

# ── Actual Budget ──────────────────────────────────────────────────────────────
# Tempo de inatividade antes de escalar para zero
ACTUAL_SESSION_DURATION=30m

# ── Mealie ─────────────────────────────────────────────────────────────────────
MEALIE_DB_NAME=mealie
MEALIE_DB_USER=mealie
MEALIE_DB_PASSWORD=CHANGE_ME
# Email e senha do administrador padrão criado na primeira execução
MEALIE_DEFAULT_EMAIL=CHANGE_ME
MEALIE_DEFAULT_PASSWORD=CHANGE_ME

# Tempo de inatividade antes de escalar para zero
MEALIE_SESSION_DURATION=30m

# ── Immich ─────────────────────────────────────────────────────────────────────
IMMICH_DB_NAME=immich
IMMICH_DB_USER=immich
IMMICH_DB_PASSWORD=CHANGE_ME

# ── Grafana ────────────────────────────────────────────────────────────────────
# Senha do usuário admin da interface web do Grafana. Gere com: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
